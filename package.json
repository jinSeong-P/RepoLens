{
  "name": "repolens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.strict.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "build": "node scripts/build-extension.mjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-manifest.mjs build/extension",
    "package:extension": "npm run build && node scripts/package-extension.mjs build/extension"
  },
  "devDependencies": {
    "@types/chrome": "0.2.5",
    "@types/node": "22.20.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
